{
  "name": "vscode-akash",
  "displayName": "AkashJS",
  "description": "IntelliSense, diagnostics, and syntax highlighting for AkashJS .akash components",
  "version": "0.2.0",
    "publisher": "akashjs",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hish/akashjs"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:akash"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "akash",
        "aliases": [
          "AkashJS",
          "akash"
        ],
        "extensions": [
          ".akash"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/akash-light.png",
          "dark": "./icons/akash-dark.png"
        }
      }
    ],
    "snippets": [
      {
        "language": "akash",
        "path": "./snippets/akash.json"
      }
    ],
    "grammars": [
      {
        "language": "akash",
        "scopeName": "source.akash",
        "path": "./syntaxes/akash.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "source.js": "javascript",
          "text.html.basic": "html",
          "source.css": "css",
          "source.css.scss": "scss"
        }
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "vsce package"
  },
  "dependencies": {
    "@akashjs/compiler": "^0.1.60",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/vscode": "1.85",
    "esbuild": "^0.21.5"
  }
}
