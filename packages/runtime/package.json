{
  "name": "@akashjs/runtime",
  "version": "0.1.5",
  "description": "AkashJS core runtime — signals, components, DOM rendering",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./test": {
      "import": "./dist/test.js",
      "require": "./dist/test.cjs"
    },
    "./store": {
      "import": "./dist/store.js"
    },
    "./ssr": {
      "import": "./dist/ssr.js"
    },
    "./sync": {
      "import": "./dist/sync.js"
    },
    "./offline": {
      "import": "./dist/offline.js"
    },
    "./animate": {
      "import": "./dist/animate.js"
    },
    "./machine": {
      "import": "./dist/machine.js"
    },
    "./pwa": {
      "import": "./dist/pwa.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
